# Connections Network: configuration template.
# Copy to .env for local development. NEVER put real secrets in this file: it is committed, and
# the CI secret scan blocks any PR that carries one.
# Keep comments on their own line: docker's --env-file reads everything after '=' as the value,
# inline comment included, and the app then rejects it as an invalid setting.
# Every variable below is required; the API refuses to start without it.

# ---------- API ----------
# One of: local | staging | production
API_ENV=local
# Comma-separated list of web origins allowed to call the API.
API_CORS_ORIGINS=http://localhost:4200

# ---------- Supabase (hosted project) ----------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-hosted-anon-key
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1

# ---------- Database ----------
# The API's connection to Postgres, as the non-bypassing role used on request paths.
DATABASE_URL=postgresql://postgres:<password>@db.your-project-ref.supabase.co:5432/postgres

# ---------- Web ----------
# Public origin of the web app.
WEB_PUBLIC_URL=http://localhost:4200
