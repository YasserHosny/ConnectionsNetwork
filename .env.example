# Connections Network: configuration template.
# Copy to .env for local development. NEVER put real secrets in this file: it is committed, and
# the CI secret scan blocks any PR that carries one.
# Keep comments on their own line: docker's --env-file reads everything after '=' as the value,
# inline comment included, and the app then rejects it as an invalid setting.
# Every variable below up to "Containers" is required; the API refuses to start without it.

# ---------- API ----------
# One of: local | staging | production
API_ENV=local
# Comma-separated list of web origins allowed to call the API.
API_CORS_ORIGINS=http://localhost:4200

# ---------- Supabase (hosted project) ----------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-hosted-anon-key
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
# OPTIONAL, unlike every other variable here. Only for local/test stacks that sign tokens with
# the shared HS256 secret. Leave it unset on hosted: tokens are then verified against the
# project's published signing keys (JWKS) and any HS256 token is refused.
# SUPABASE_JWT_SECRET=replace-with-local-jwt-secret

# ---------- Database ----------
# The API's connection to Postgres, as the non-bypassing role used on request paths.
DATABASE_URL=postgresql://postgres:<password>@db.your-project-ref.supabase.co:5432/postgres

# ---------- Web ----------
# Public origin of the web app.
WEB_PUBLIC_URL=http://localhost:4200

# ---------- Containers (docker-compose.yml and the deployed images) ----------
# docker compose reads SUPABASE_URL and SUPABASE_ANON_KEY above for the web container too: it
# writes them to runtime-config.json and the CSP connect-src at start. SUPABASE_URL must then be
# a bare origin (no path, no trailing slash).
# Host the web container proxies /api to. `api` under docker compose (the default); `localhost`
# in the shared bunny.net app, where the api and web containers share one network.
BACKEND_HOST=api
# Optional. Address(es) uvicorn trusts forwarded headers from. The image defaults to 127.0.0.1
# (the bunny.net app); docker-compose.yml defaults to the compose network. Never "*".
# FORWARDED_ALLOW_IPS=172.16.0.0/12
